# Copie para .env e ajuste:  cp .env.example .env
# O .env está no .gitignore. Nunca commite senha de verdade.

# Banco (Postgres). Só vale na 1ª subida: depois disso o banco já existe no volume.
# Para trocar a senha depois, apague o volume com: docker compose down -v
DB_NAME=rotavital
DB_USER=rotavital
DB_PASSWORD=troque-esta-senha

# Porta da API no seu computador: http://localhost:8080
API_PORT=8080

# Opções da JVM. Gerar 1 milhão de requisições usa ~150-200 MB de heap.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
